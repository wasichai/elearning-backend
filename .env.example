# Copia este archivo a `.env` (ignorado por git) y ajusta los valores. Nunca subas secretos.
# Valores de desarrollo: no se reutilizan en ningún otro entorno.

# Base de datos local (compose.yaml publica PostgreSQL 18 solo en loopback)
ELEARNING_DB_HOST=127.0.0.1
ELEARNING_DB_PORT=5436
ELEARNING_DB_NAME=elearning
ELEARNING_DB_USERNAME=elearning
ELEARNING_DB_PASSWORD=elearning-dev

# Firma de los JWT de Wasichai: al menos 32 bytes. Genera uno con `openssl rand -base64 48`.
WASICHAI_JWT_SECRET=

# Nombre visible del producto (no forma parte del dominio)
LMS_PRODUCT_NAME=wasichai-learning

# Organización (tenant) cuyo catálogo es público
LMS_PUBLIC_ORGANIZATION=

# Solo para compilar: GitHub Packages exige un token con read:packages.
# No lo guardes aquí: expórtalo en tu shell con  GITHUB_ACTOR=$(gh api user -q .login) GITHUB_TOKEN=$(gh auth token)
