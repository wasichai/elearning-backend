# Copia este archivo a `.env` (ignorado por git) y ajusta los valores. Nunca subas secretos.
# `./gradlew bootRun` y `docker compose` leen `.env`. Valores de desarrollo: no se reutilizan en ningún otro entorno.

# Base de datos local (compose.yaml publica PostgreSQL 18 solo en 127.0.0.1). Wasichai lee estas variables.
WASICHAI_DB_HOST=127.0.0.1
WASICHAI_DB_PORT=5436
WASICHAI_DB_NAME=elearning
WASICHAI_DB_USERNAME=elearning
WASICHAI_DB_PASSWORD=elearning-dev

# Firma de los JWT: al menos 32 bytes y sin valor por defecto. Genera uno con:  openssl rand -base64 48
WASICHAI_JWT_SECRET=

# Orígenes de navegador permitidos (CORS), separados por comas. Vacío: ninguno ajeno (UI y API en el mismo dominio).
# El perfil dev ya permite http://localhost:*. En producción, el dominio exacto de la UI: https://cursos.ejemplo.org
WASICHAI_CORS_ALLOWED_ORIGINS=

# Nombre visible del producto (no forma parte del dominio)
LMS_PRODUCT_NAME=wasichai-learning

# Organización (tenant) cuyo catálogo es público: su slug (la semilla de desarrollo de Wasichai crea `demo`)
LMS_PUBLIC_ORGANIZATION=demo

# Solo para compilar: GitHub Packages exige un token con read:packages. No lo guardes aquí; en tu shell:
#   export GITHUB_ACTOR=$(gh api user -q .login) GITHUB_TOKEN=$(gh auth token)
