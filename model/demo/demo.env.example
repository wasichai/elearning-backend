# Variables de la demo poblada (model/demo/README.md). demo.sh usa demo.env si existe (no se versiona) y si no, este:
#
#   cp model/demo/demo.env.example model/demo/demo.env
#
# Todo es local y desechable. Ningún valor de aquí sirve fuera de la demo.

# --- Base (compose.demo.yml: proyecto elearning-demo, 127.0.0.1:5446, base elearning_demo) ---
WASICHAI_DB_HOST=127.0.0.1
WASICHAI_DB_PORT=5446
WASICHAI_DB_NAME=elearning_demo
WASICHAI_DB_USERNAME=elearning
WASICHAI_DB_PASSWORD=elearning-demo
LMS_DEMO_PG_PORT=5446

# --- Backend de la demo: otro puerto que el 8090 de desarrollo, perfil dev (semilla admin@wasichai.local / admin) ---
PORT=8096
SPRING_PROFILES_ACTIVE=dev
WASICHAI_JWT_SECRET=elearning-demo-solo-local-0123456789abcdef
LMS_PUBLIC_ORGANIZATION=demo
LMS_PRODUCT_NAME=wasichai-learning
LMS_FILES_PATH=build/demo/archivos
SPRING_MAIL_PORT=1046

# --- Siembra (model/apply.py) ---
WASICHAI_URL=http://localhost:8096
WASICHAI_EMAIL=admin@wasichai.local
WASICHAI_PASSWORD=admin

# --- Clave de todas las cuentas demo (data.json y poblada.json). Solo para la demo local ---
WASICHAI_DEMO_PASSWORD=Demo-2026

# --- Frontend contra esta demo (elearning-frontend): WASICHAI_API_URL=http://localhost:8096 yarn dev ---
WASICHAI_API_URL=http://localhost:8096

# --- Zona horaria de las ediciones de la demo ---
TZ=America/Lima
