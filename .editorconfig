root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 160

[*.{yml,yaml,json,md,mjs,ts,tsx,sql,toml}]
indent_size = 2

[*.{kt,kts}]
ktlint_code_style = ktlint_official

[*.bat]
end_of_line = crlf
